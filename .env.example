# ============================================================
#  Muhit o'zgaruvchilari namunasi
#  Nusxa oling:  cp .env.example .env.local
#  va o'z qiymatlaringizni yozing.
# ============================================================

# --- Sayt manzili (SEO, RSS, sitemap uchun) -------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (admin panel va dinamik kontent uchun) ----------
# Supabase → Project Settings → API bo'limidan olinadi
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=media

# --- Admin panel himoyasi ------------------------------------
# Kuchli parol tanlang! Standart qiymat faqat sinov uchun.
ADMIN_PASSWORD=admin123
# Sessiya imzosini shifrlash uchun tasodifiy satr
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=change-me-in-production-please

# --- GitHub integratsiyasi (loyihalar avtomatik tortiladi) ----
GITHUB_USERNAME=
# Faqat ommaviy repolar yetarli bo'lsa shart emas.
# Shaxsiy repo va yuqori limit uchun token yarating:
# github.com → Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=

# --- Email bildirishnoma (majburiy emas) ----------------------
# resend.com dan bepul kalit olinadi
RESEND_API_KEY=
CONTACT_EMAIL=
RESEND_FROM=onboarding@resend.dev

# --- Analitika (majburiy emas) --------------------------------
# Bo'sh qolsa hech qanday skript yuklanmaydi.
# umami: cloud.umami.is → Settings → Websites → Website ID
# plausible: plausible.io → Site settings → domain
NEXT_PUBLIC_ANALYTICS_ID=
NEXT_PUBLIC_ANALYTICS_PROVIDER=umami
# O'z serveringiz bo'lsa (masalan o'zingiz joylagan Umami):
NEXT_PUBLIC_ANALYTICS_URL=
